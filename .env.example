# Anthropic API — используется только для генерации текста объяснений (не для ранжирования)
ANTHROPIC_API_KEY=

# Модель для объяснений
NEUROFORGE_LLM_MODEL=claude-haiku-4-5-20251001

# Таймаут на LLM-вызов (сек) — при превышении используется шаблонный fallback,
# чтобы уложиться в требование "ответ до 10 секунд"
NEUROFORGE_LLM_TIMEOUT_S=4

# Локальная модель эмбеддингов (мультиязычная, для семантического сходства описаний)
NEUROFORGE_EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# Пути к данным
NEUROFORGE_DATASET_PATH=data/raw/hackathon-dataset-anonymized.jsonl
NEUROFORGE_SYNTHETIC_PATH=data/synthetic/extra_profiles.jsonl
