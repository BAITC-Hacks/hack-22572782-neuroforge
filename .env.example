# Ключи провайдеров LLM. Используются ТОЛЬКО для выбора проверенных фактов;
# фильтрация и ранжирование работают локально и без сети.
# Если ключей нет, сервис отвечает шаблонными объяснениями на тех же фактах.
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Полностью отключить LLM (демонстрация шаблонного режима)
NEUROFORGE_LLM_ENABLED=true

# Бюджет одного провайдера и общий бюджет ожидания всех карточек, секунд.
NEUROFORGE_LLM_TIMEOUT_S=4
NEUROFORGE_LLM_TOTAL_TIMEOUT_S=5

# Локальная модель эмбеддингов (мультиязычная, для семантики описаний)
NEUROFORGE_EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# Пути к данным
NEUROFORGE_DATASET_PATH=data/raw/hackathon-dataset-anonymized.jsonl
NEUROFORGE_SYNTHETIC_PATH=data/synthetic/extra_profiles.jsonl

# Подтверждённое окно календаря из ТЗ, не минимум/максимум занятых дат.
NEUROFORGE_CALENDAR_START=2026-09-23
NEUROFORGE_CALENDAR_END=2026-12-31

# Необязательная настройка весов; неприменимые фичи исключаются.
# NEUROFORGE_SCORING__SEMANTIC_SIMILARITY=0.55
# NEUROFORGE_SCORING__BUDGET_HEADROOM=0.10
# NEUROFORGE_SCORING__DURATION_MARGIN=0.20
# NEUROFORGE_SCORING__LANGUAGE_BREADTH=0.15
